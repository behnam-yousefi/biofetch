# Copy this file to .env and fill in the values you have.
# .env is gitignored — never commit real keys/paths.
#
# biofetch reads these directly from the process environment (os.getenv).
# It does not load .env itself — either export these in your shell, use
# `python-dotenv` (pip install python-dotenv; load_dotenv() before importing
# biofetch), or, if biofetch is used from bcai/pharma-search, add these
# lines to that project's own env file instead of duplicating this one.

# search_omim — register at https://www.omim.org/api
OMIM_API_KEY=

# search_disgenet — register at https://disgenet.com
DISGENET_API_KEY=

# search_drugbank — path to the extracted drugbank_all_full_database.xml
# (requires a DrugBank account/license: https://go.drugbank.com/releases/latest)
DRUGBANK_XML_PATH=

# search_sider — path to a directory containing drug_names.tsv and
# meddra_all_se.tsv.gz (https://sideeffects.embl.de/)
SIDER_DIR=

# search_orphanet — optional, defaults to "biofetch" if unset.
# Per the API's own docs this is just a self-chosen usage identifier, not a real secret.
ORPHANET_API_KEY=
